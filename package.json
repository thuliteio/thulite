{
  "name": "thulite",
  "version": "3.0.1",
  "description": "Thulite",
  "author": "Thulite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuliteio/thulite.git"
  },
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "portless": "portless run thulite-portless",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@thulite/core": "^2.0.3"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "portless": "^0.15.6",
    "prettier": "^3.9.9",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
